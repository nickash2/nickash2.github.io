---
import { siteConfig } from "../config";
import Section from "./Section.astro";
---

<Section id="about" title="About Me">
  <div class="space-y-8">
    <p class="max-w-[65ch] text-lg sm:text-xl md:text-2xl leading-relaxed text-gray-300">
      {siteConfig.aboutMe}
    </p>

    <ul class="flex flex-wrap gap-3 pt-4" aria-label="Skills">
      {
        siteConfig.skills.map((skill) => (
          <li class="px-3 sm:px-4 py-1.5 sm:py-2 bg-gray-700 text-gray-200 rounded-full text-sm sm:text-base md:text-lg font-medium">
            {skill}
          </li>
        ))
      }
    </ul>
  </div>
</Section>
