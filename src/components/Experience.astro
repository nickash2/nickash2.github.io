---
import { siteConfig } from "../config";
import Section from "./Section.astro";
import EntryCard from "./EntryCard.astro";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <Section id="experience" title="Experience">
      <ol class="relative">
        {siteConfig.experience.map((exp, index) => (
          <li class="relative mb-12 last:mb-0">
            <div
              class="absolute left-1/2 -top-2 w-4 h-4 rounded-full -translate-x-1/2 z-20 bg-accent"
              aria-hidden="true"
            />
            {index < siteConfig.experience.length - 1 && (
              <div
                class="absolute left-1/2 bottom-0 w-0.5 h-12 bg-gray-600 -translate-x-1/2 translate-y-full z-10"
                aria-hidden="true"
              />
            )}
            <EntryCard
              title={exp.title}
              subtitle={exp.company}
              dateRange={exp.dateRange}
              logo={exp.logo}
              items={exp.bullets}
            />
          </li>
        ))}
      </ol>
    </Section>
  )
}
