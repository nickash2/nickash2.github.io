---
import { siteConfig } from "../config";
import Section from "./Section.astro";

type Role = (typeof siteConfig.experience)[number];
const groups: { company: string; logo?: string; roles: Role[] }[] = [];
for (const exp of siteConfig.experience ?? []) {
  const last = groups[groups.length - 1];
  if (last && last.company === exp.company) last.roles.push(exp);
  else groups.push({ company: exp.company, logo: exp.logo, roles: [exp] });
}
---

{
  groups.length > 0 && (
    <Section id="experience" title="Experience">
      <ol class="divide-y divide-gray-700/70 border-y border-gray-700/70">
        {groups.map((group) => (
          <li class="py-6 sm:grid sm:grid-cols-[3rem_1fr] sm:gap-x-5">
            <div class="hidden sm:block pt-1">
              {group.logo && (
                <img
                  src={group.logo}
                  alt=""
                  width="48"
                  height="48"
                  loading="lazy"
                  decoding="async"
                  class="w-12 h-12 rounded-md object-contain bg-gray-700"
                />
              )}
            </div>
            <div>
              <h3 class="text-lg sm:text-xl font-semibold text-gray-100 text-balance">{group.company}</h3>
              <ul class="mt-1">
                {group.roles.map((role) => (
                  <li>
                    <details class="group/role">
                      <summary class="flex min-h-11 cursor-pointer list-none items-center gap-x-4 py-2 [&::-webkit-details-marker]:hidden">
                        <span class="flex flex-1 min-w-0 flex-col sm:flex-row sm:items-baseline sm:justify-between gap-x-4 gap-y-0.5">
                          <span class="text-base sm:text-lg text-gray-300 group-hover/role:text-gray-100 transition-colors">
                            {role.title}
                          </span>
                          <span class="shrink-0 font-mono text-xs sm:text-sm text-gray-400 whitespace-nowrap">
                            {role.dateRange}
                          </span>
                        </span>
                        <svg
                          class="shrink-0 w-4 h-4 text-gray-400 transition-transform duration-200 group-open/role:rotate-180"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                        >
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 9l6 6 6-6" />
                        </svg>
                      </summary>
                      <ul class="mt-1 mb-3 space-y-2 max-w-[65ch] list-disc pl-5 marker:text-gray-500">
                        {role.bullets.map((bullet) => (
                          <li class="text-sm sm:text-base text-gray-300 leading-relaxed">{bullet}</li>
                        ))}
                      </ul>
                    </details>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </Section>
  )
}
