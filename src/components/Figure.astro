---
interface Props {
  src: string;
  srcSmall?: string;
  width: number;
  height: number;
  alt: string;
  caption: string;
  source?: string;
  link?: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
  imgClass?: string;
  /** Cap the rendered width (px) for low-resolution sources so they are not upscaled further. */
  maxDisplayWidth?: number;
}

const {
  src,
  srcSmall,
  width,
  height,
  alt,
  caption,
  source,
  link,
  sizes = "(min-width: 1024px) 50vw, 100vw",
  eager = false,
  class: className = "",
  imgClass = "",
  maxDisplayWidth,
} = Astro.props;

const smallWidth = srcSmall?.match(/-(\d+)\.\w+$/)?.[1];
const srcset = srcSmall && smallWidth ? `${srcSmall} ${smallWidth}w, ${src} ${width}w` : undefined;
---

<figure class={className} style={maxDisplayWidth ? `max-width: ${maxDisplayWidth}px` : undefined}>
  <a
    href={src}
    target="_blank"
    rel="noopener"
    class="figure-plate group relative isolate block rounded-md p-2 sm:p-3 ring-1 ring-white/10 shadow-[0_18px_40px_-20px_rgb(0_0_0/0.7)] transition-[box-shadow] duration-200"
  >
    <span class="sr-only">Open full-size figure (opens in a new tab): </span>
    <img
      src={src}
      srcset={srcset}
      sizes={srcset ? sizes : undefined}
      width={width}
      height={height}
      alt={alt}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
      class={`block w-full h-auto mix-blend-multiply ${imgClass}`}
    />
    <svg
      class="absolute right-3 top-3 sm:right-4 sm:top-4 h-7 w-7 rounded bg-gray-900/80 p-1.5 text-gray-100 opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 9V4h5M20 15v5h-5M4 4l6 6M20 20l-6-6" />
    </svg>
  </a>
  <figcaption class="mt-3 font-mono text-xs sm:text-sm leading-relaxed text-gray-400">
    {caption}
    {source && " "}
    {
      source &&
        (link ? (
          <a
            href={link}
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent-text underline underline-offset-4 decoration-1 hover:decoration-2"
          >
            {source}
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        ) : (
          <span class="text-gray-300">{source}</span>
        ))
    }
  </figcaption>
</figure>

<style>
  /* Paper-toned plate: multiplying the figure onto it turns glaring white
     into a soft paper grey while plotted colours and labels stay intact. */
  .figure-plate {
    background-color: var(--paper);
  }
  .figure-plate:hover {
    box-shadow:
      0 0 0 2px var(--accent-text),
      0 18px 40px -20px rgb(0 0 0 / 0.7);
  }
</style>
