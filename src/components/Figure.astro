---
interface Props {
  src: string;
  srcSmall?: string;
  width: number;
  height: number;
  alt: string;
  caption: string;
  source?: string;
  link?: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
  imgClass?: string;
}

const {
  src,
  srcSmall,
  width,
  height,
  alt,
  caption,
  source,
  link,
  sizes = "(min-width: 1024px) 50vw, 100vw",
  eager = false,
  class: className = "",
  imgClass = "",
} = Astro.props;

const smallWidth = srcSmall?.match(/-(\d+)\.\w+$/)?.[1];
const srcset = srcSmall && smallWidth ? `${srcSmall} ${smallWidth}w, ${src} ${width}w` : undefined;
---

<figure class={className}>
  <div class="rounded-md bg-white p-2 sm:p-3 shadow-[0_18px_40px_-20px_rgb(0_0_0/0.7)]">
    <img
      src={src}
      srcset={srcset}
      sizes={srcset ? sizes : undefined}
      width={width}
      height={height}
      alt={alt}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
      class={`block w-full h-auto ${imgClass}`}
    />
  </div>
  <figcaption class="mt-3 font-mono text-xs sm:text-sm leading-relaxed text-gray-400">
    {caption}
    {
      source &&
        (link ? (
          <a
            href={link}
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent-text underline underline-offset-4 decoration-1 hover:decoration-2"
          >
            {source}
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        ) : (
          <span class="text-gray-300">{source}</span>
        ))
    }
  </figcaption>
</figure>
