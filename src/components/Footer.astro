---
import { siteConfig } from "../config";
import { navItems } from "../navItems";
import SocialLinks from "./SocialLinks.astro";
---

<footer class="bg-gray-800 border-t border-gray-700">
  <div class="mx-auto max-w-6xl px-6 py-12 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-8">
      <div class="flex flex-col gap-4">
        <p class="text-2xl font-bold text-gray-100">{siteConfig.name}</p>
        <p class="text-base text-gray-300">{siteConfig.title}</p>
        <SocialLinks class="-ml-2" />
      </div>

      <div class="flex flex-col md:items-end gap-4">
        <nav aria-label="Footer">
          <ul class="flex flex-wrap gap-x-6 gap-y-1">
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="inline-flex items-center min-h-11 text-sm text-gray-300 hover:text-white transition-colors"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <p class="text-sm text-gray-400">
          © {new Date().getFullYear()} {siteConfig.name}. All rights reserved.
        </p>
      </div>
    </div>
  </div>
</footer>
