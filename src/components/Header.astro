---
import { siteConfig } from "../config";
import { navItems } from "../navItems";
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 bg-gray-900/90 backdrop-blur-sm md:bg-transparent md:backdrop-blur-none transition-colors duration-300"
>
  <nav
    aria-label="Primary"
    class="max-w-7xl mx-auto flex items-center gap-3 px-4 md:px-8 py-1.5 md:py-3"
  >
    <ul
      class="flex flex-1 items-center gap-1 md:gap-6 md:justify-center overflow-x-auto [scrollbar-width:none] [mask-image:linear-gradient(to_right,black_85%,transparent)] md:[mask-image:none]"
    >
      {
        navItems.map((item) => (
          <li class="shrink-0">
            <a
              href={item.href}
              class="inline-flex items-center min-h-11 px-2 text-sm md:text-base whitespace-nowrap text-gray-300 hover:text-white transition-colors font-medium"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href={siteConfig.resume}
      target="_blank"
      rel="noopener noreferrer"
      class="shrink-0 inline-flex items-center min-h-11 bg-accent text-white px-4 rounded-md text-sm font-medium hover:opacity-90 transition-opacity"
    >
      CV<span class="sr-only"> (opens in a new tab)</span>
    </a>
  </nav>
</header>

<script>
  const header = document.getElementById("header");
  let scrolled = false;
  const update = () => {
    const next = window.scrollY > 100;
    if (next !== scrolled) {
      scrolled = next;
      header?.classList.toggle("is-scrolled", scrolled);
    }
  };
  update();
  window.addEventListener("scroll", update, { passive: true });
</script>

<style>
  .is-scrolled {
    background-color: rgb(17 24 39 / 0.85);
    backdrop-filter: blur(8px);
  }
</style>
