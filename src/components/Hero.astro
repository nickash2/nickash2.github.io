---
import { siteConfig } from "../config";
import SocialLinks from "./SocialLinks.astro";
import Figure from "./Figure.astro";

const statement = siteConfig.researchStatement ?? "";
const splitAt = statement.indexOf(":");
const lead = splitAt > -1 ? statement.slice(0, splitAt + 1) : statement;
const rest = splitAt > -1 ? statement.slice(splitAt + 1) : "";
const figure = siteConfig.heroFigure;
---

<section
  id="hero"
  aria-labelledby="hero-heading"
  class="relative isolate overflow-hidden bg-gray-900 pt-24 pb-16 md:pt-32 md:pb-20 lg:min-h-[100svh] lg:flex lg:items-center"
>
  <div
    class="absolute inset-0 -z-10"
    aria-hidden="true"
    style={`background: radial-gradient(ellipse 900px 1100px at 0% 0%, ${siteConfig.accentColor}2e 0%, ${siteConfig.accentColor}12 30%, transparent 65%), #0f1419`}
  >
  </div>

  <div
    class="w-full px-8 sm:px-12 md:px-16 lg:px-24 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center"
  >
    <div class="lg:col-span-6 xl:col-span-6">
      <h1
        id="hero-heading"
        class="text-5xl sm:text-6xl lg:text-7xl xl:text-[5.5rem] font-bold leading-[0.95] tracking-[-0.035em] text-gray-100 text-balance"
      >
        {siteConfig.name}
      </h1>
      <p class="mt-5 font-mono text-sm sm:text-base text-accent-text">
        {siteConfig.title}{siteConfig.tagline && <span class="text-gray-400"> &middot; {siteConfig.tagline}</span>}
      </p>

      {
        statement && (
          <p class="mt-8 sm:mt-10 max-w-[38ch] text-xl sm:text-2xl xl:text-[1.75rem] leading-snug text-gray-300 text-pretty">
            <span class="font-semibold text-gray-100">{lead}</span>
            {rest}
          </p>
        )
      }

      <div class="mt-10 flex flex-wrap items-center gap-x-4 sm:gap-x-6 gap-y-3">
        <a
          href={siteConfig.resume}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 min-h-11 bg-accent text-white px-5 py-2 rounded-md text-base font-medium hover:opacity-90 transition-opacity"
        >
          View CV<span class="sr-only"> (opens in a new tab)</span>
        </a>
        <a
          href="#publications"
          class="inline-flex items-center min-h-11 px-1 text-base font-medium text-gray-100 underline underline-offset-[6px] decoration-gray-500 hover:decoration-[var(--accent-text)] transition-colors"
        >
          Publications
        </a>
        <SocialLinks class="-ml-1" iconClass="h-6 w-6 sm:h-7 sm:w-7" />
      </div>
    </div>

    {
      figure && (
        <Figure
          class="lg:col-span-6"
          src={figure.src}
          srcSmall={figure.srcSmall}
          width={figure.width}
          height={figure.height}
          alt={figure.alt}
          caption={`${figure.caption} `}
          source={figure.source}
          link={figure.link}
          eager
          imgClass="plot-reveal"
        />
      )
    }
  </div>
</section>

<style is:global>
  /* The forecast is drawn left to right, like the time series unfolding. */
  @media (prefers-reduced-motion: no-preference) {
    .plot-reveal {
      animation: plot-reveal 1.6s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
    }
  }

  @keyframes plot-reveal {
    from {
      clip-path: inset(0 72% 0 0);
      filter: blur(2px);
    }
    to {
      clip-path: inset(0 0 0 0);
      filter: blur(0);
    }
  }
</style>
