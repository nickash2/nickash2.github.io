---
import { formatDate, type Post } from "../lib/blog";

interface Props {
  posts: Post[];
  headingLevel?: "h2" | "h3";
}

const { posts, headingLevel: Heading = "h3" } = Astro.props;
---

<ol class="divide-y divide-gray-700/70 border-y border-gray-700/70">
  {
    posts.map((post) => (
      <li>
        <article class="group relative py-7 sm:py-8">
          <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-sm text-gray-400">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            {post.data.draft && (
              <span class="rounded border border-amber-300/40 px-1.5 py-0.5 text-xs text-amber-200">
                Draft · local preview only
              </span>
            )}
          </p>
          <Heading class="mt-2 text-2xl sm:text-[1.75rem] font-semibold leading-tight tracking-[-0.015em] text-gray-100 text-balance">
            <a
              href={`/blog/${post.id}/`}
              class="underline decoration-transparent decoration-1 underline-offset-[6px] transition-colors group-hover:decoration-[var(--accent-text)] after:absolute after:inset-0"
            >
              {post.data.title}
            </a>
          </Heading>
          <p class="mt-3 max-w-[62ch] text-base sm:text-lg leading-relaxed text-gray-300 text-pretty">
            {post.data.description}
          </p>
        </article>
      </li>
    ))
  }
</ol>
