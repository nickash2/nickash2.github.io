---
import { siteConfig } from "../config";
import Section from "./Section.astro";
import Figure from "./Figure.astro";

type Publication = (typeof siteConfig.publications)[number] & {
  collaboration?: string;
  figure?: {
    src: string;
    srcSmall?: string;
    width: number;
    height: number;
    alt: string;
    caption: string;
    source?: string;
    link?: string;
    maxDisplayWidth?: number;
  };
};

const publications = (siteConfig.publications ?? []) as Publication[];
---

{
  publications.length > 0 && (
    <Section id="publications" title="Publications">
      <ol class="divide-y divide-gray-700/70">
        {publications.map((p) => (
          <li class="py-10 first:pt-0 last:pb-0">
            <article>
              <h3 class="max-w-[30ch] text-2xl sm:text-3xl lg:text-[2.25rem] font-semibold leading-tight tracking-[-0.02em] text-gray-100 text-balance">
                {p.title}
              </h3>
              <p class="mt-4 font-mono text-sm sm:text-base text-accent-text">
                {p.venue}
                <span class="text-gray-400"> · {p.year}</span>
              </p>

              {p.collaboration ? (
                <p class="mt-4 text-lg sm:text-xl text-gray-300">
                  {p.authors}, in collaboration with{" "}
                  <strong class="font-semibold text-gray-100">{p.collaboration}</strong>
                </p>
              ) : (
                <p class="mt-4 text-lg sm:text-xl text-gray-300">
                  {p.authors}
                  {p.note && <span class="text-gray-400"> — {p.note}</span>}
                </p>
              )}

              {p.figure && (
                <Figure
                  class="mt-8 max-w-3xl"
                  src={p.figure.src}
                  srcSmall={p.figure.srcSmall}
                  width={p.figure.width}
                  height={p.figure.height}
                  alt={p.figure.alt}
                  caption={p.figure.caption}
                  source={p.figure.source}
                  link={p.figure.link}
                  maxDisplayWidth={p.figure.maxDisplayWidth}
                  sizes="(min-width: 1024px) 48rem, 100vw"
                />
              )}

              {p.link && (
                <a
                  href={p.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-6 inline-flex items-center gap-1.5 min-h-11 text-base text-accent-text font-medium underline underline-offset-4 decoration-1 hover:decoration-2"
                >
                  Read paper
                  <span class="sr-only">: {p.title} (opens in a new tab)</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
                  </svg>
                </a>
              )}
            </article>
          </li>
        ))}
      </ol>
    </Section>
  )
}
