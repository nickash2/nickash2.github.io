---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section
  id={id}
  aria-labelledby={`${id}-heading`}
  class="p-8 sm:p-12 md:p-16 lg:p-24"
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
    <div class="lg:col-span-4">
      <h2
        id={`${id}-heading`}
        class="text-3xl sm:text-4xl md:text-5xl lg:text-[min(calc(4.5vw-16px),4.5rem)] font-bold text-gray-100 text-balance"
      >
        {title}
      </h2>
      <div class="w-[75px] h-[5px] mt-2 rounded-full bg-accent" aria-hidden="true">
      </div>
    </div>

    <div class="lg:col-span-8">
      <slot />
    </div>
  </div>
</section>
