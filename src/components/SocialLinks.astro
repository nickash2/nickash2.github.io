---
import { siteConfig } from "../config";

interface Props {
  iconClass?: string;
  class?: string;
}

const { iconClass = "h-6 w-6", class: className = "" } = Astro.props;

const social: Partial<Record<"email" | "linkedin" | "twitter" | "github", string>> =
  siteConfig.social ?? {};

// Tabler icon paths
const links = [
  social.email && {
    label: "Email",
    href: `mailto:${social.email}`,
    external: false,
    paths: [
      "M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z",
      "M3 7l9 6l9 -6",
    ],
  },
  social.linkedin && {
    label: "LinkedIn",
    href: social.linkedin,
    external: true,
    paths: [
      "M8 11v5",
      "M8 8v.01",
      "M12 16v-5",
      "M16 16v-3a2 2 0 1 0 -4 0",
      "M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z",
    ],
  },
  social.twitter && {
    label: "X (Twitter)",
    href: social.twitter,
    external: true,
    paths: [
      "M4 4l11.733 16h4.267l-11.733 -16z",
      "M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772",
    ],
  },
  social.github && {
    label: "GitHub",
    href: social.github,
    external: true,
    paths: [
      "M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5",
    ],
  },
].filter(Boolean) as { label: string; href: string; external: boolean; paths: string[] }[];
---

<ul class={`flex items-center gap-x-1 sm:gap-x-2 ${className}`}>
  {
    links.map((link) => (
      <li>
        <a
          href={link.href}
          aria-label={link.label}
          {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
          class="inline-flex items-center justify-center min-w-11 min-h-11 p-1.5 rounded-md text-gray-300 transition-colors duration-300 hover:text-accent-text"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class={iconClass}
            aria-hidden="true"
          >
            {link.paths.map((d) => <path d={d} />)}
          </svg>
        </a>
      </li>
    ))
  }
</ul>
