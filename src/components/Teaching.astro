---
import { siteConfig } from "../config";
import Section from "./Section.astro";

const teaching = siteConfig.teaching ?? [];
---

{
  teaching.length > 0 && (
    <Section id="teaching" title="Teaching">
      <ol class="space-y-14">
        {teaching.map((t) => (
          <li>
            <div class="flex items-center gap-3">
              {t.logo && (
                <img
                  src={t.logo}
                  alt=""
                  width="40"
                  height="40"
                  loading="lazy"
                  decoding="async"
                  class="w-10 h-10 rounded-md object-contain bg-gray-700"
                />
              )}
              <div class="flex flex-1 flex-col sm:flex-row sm:items-baseline sm:justify-between gap-x-4 gap-y-0.5">
                <h3 class="text-xl sm:text-2xl font-semibold tracking-[-0.01em] text-gray-100">
                  {t.role}, <span class="text-accent-text">{t.institution}</span>
                </h3>
                <span class="shrink-0 font-mono text-xs sm:text-sm text-gray-400 whitespace-nowrap">{t.dateRange}</span>
              </div>
            </div>

            {t.courses.length > 0 && (
              <ul class="mt-6 border-y border-gray-700/70 divide-y divide-gray-700/70" aria-label="Courses">
                {t.courses.map((course) => (
                  <li class="py-4 text-xl sm:text-2xl lg:text-[1.75rem] font-medium leading-snug tracking-[-0.015em] text-gray-100 text-balance">
                    {course}
                  </li>
                ))}
              </ul>
            )}

            {t.responsibilities.length > 0 && (
              <ul class="mt-6 grid gap-x-8 gap-y-2 sm:grid-cols-2 max-w-[65ch] list-disc pl-5 marker:text-gray-500">
                {t.responsibilities.map((item) => (
                  <li class="text-sm sm:text-base text-gray-300 leading-relaxed">{item}</li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </Section>
  )
}
