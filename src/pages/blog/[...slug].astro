---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import { getPosts, formatDate, type Post } from "../../lib/blog";
import { siteConfig } from "../../config";

// One route for both /blog/ and /blog/<post>/. While there are no
// published posts, production builds emit neither (drafts render in dev only).
export async function getStaticPaths() {
  const posts = await getPosts();
  if (posts.length === 0) return [];
  return [
    { params: { slug: undefined }, props: { posts } },
    ...posts.map((post) => ({ params: { slug: post.id }, props: { post } })),
  ];
}

type Props = { posts: Post[]; post?: undefined } | { post: Post; posts?: undefined };

const { posts, post } = Astro.props;
const rendered = post ? await render(post) : undefined;
const Content = rendered?.Content;
---

{
  post && Content ? (
    <BaseLayout title={`${post.data.title} - ${siteConfig.name}`} description={post.data.description} type="article">
      <article class="px-6 sm:px-12 md:px-16 pt-28 pb-20 md:pt-36 md:pb-28">
        <div class="mx-auto max-w-[68ch]">
          <a
            href="/blog/"
            class="-ml-1 inline-flex items-center gap-1.5 min-h-11 px-1 font-mono text-sm text-gray-400 hover:text-gray-100 transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5M11 18l-6-6 6-6" />
            </svg>
            All posts
          </a>

          <header class="mt-8">
            <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-sm text-accent-text">
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              {post.data.updatedDate && (
                <span class="text-gray-400">
                  Updated <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate)}</time>
                </span>
              )}
            </p>
            <h1 class="mt-4 text-4xl sm:text-5xl font-bold leading-[1.05] tracking-[-0.03em] text-gray-100 text-balance">
              {post.data.title}
            </h1>
            <p class="mt-6 text-xl sm:text-2xl leading-snug text-gray-300 text-pretty">{post.data.description}</p>
          </header>

          {post.data.draft && (
            <p class="mt-8 rounded-md border border-amber-300/40 px-4 py-3 text-sm leading-relaxed text-amber-100">
              <strong class="font-semibold">Draft.</strong> Visible only in local development; it is not included in
              production builds. Set <code class="font-mono">draft: false</code> to publish.
            </p>
          )}

          <div class="article-body mt-12 border-t border-gray-700/70 pt-10">
            <Content />
          </div>
        </div>
      </article>
    </BaseLayout>
  ) : (
    <BaseLayout title={`Blog - ${siteConfig.name}`} description={`Blog posts by ${siteConfig.name}.`}>
      <section aria-labelledby="blog-heading" class="px-6 sm:px-12 md:px-16 lg:px-24 pt-28 pb-20 md:pt-36 md:pb-28">
        <div class="mx-auto max-w-4xl">
          <h1
            id="blog-heading"
            class="text-5xl sm:text-6xl font-bold tracking-[-0.03em] text-gray-100"
          >
            Blog
          </h1>
          <div class="w-[75px] h-[5px] mt-2 mb-12 rounded-full bg-accent" aria-hidden="true"></div>
          <PostList posts={posts ?? []} headingLevel="h2" />
        </div>
      </section>
    </BaseLayout>
  )
}

<style is:global>
  .article-body {
    font-size: 1.125rem;
    line-height: 1.75;
    color: #d1d5db;
  }
  .article-body > * + * {
    margin-top: 1.25em;
  }
  .article-body h2 {
    margin-top: 2.25em;
    font-size: 1.75rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: #f3f4f6;
  }
  .article-body h3 {
    margin-top: 1.75em;
    font-size: 1.3rem;
    line-height: 1.3;
    font-weight: 600;
    color: #f3f4f6;
  }
  .article-body h2 + *,
  .article-body h3 + * {
    margin-top: 0.75em;
  }
  .article-body a {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .article-body a:hover {
    text-decoration-thickness: 2px;
  }
  .article-body strong {
    font-weight: 600;
    color: #f3f4f6;
  }
  .article-body ul,
  .article-body ol {
    padding-left: 1.4em;
  }
  .article-body ul {
    list-style: disc;
  }
  .article-body ol {
    list-style: decimal;
  }
  .article-body li + li {
    margin-top: 0.4em;
  }
  .article-body li::marker {
    color: #6b7280;
  }
  .article-body blockquote {
    padding: 0.25em 0 0.25em 1.25em;
    border-left: 1px solid #4b5563;
    font-style: italic;
    color: #9ca3af;
  }
  .article-body :not(pre) > code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.07);
    color: #e5e7eb;
  }
  .article-body pre {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.65;
    padding: 1.1rem 1.25rem;
    border-radius: 6px;
    border: 1px solid rgb(255 255 255 / 0.08);
    overflow-x: auto;
  }
  .article-body img {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
    background: var(--paper);
  }
  .article-body hr {
    margin: 3em 0;
    border-color: rgb(255 255 255 / 0.1);
  }
</style>
